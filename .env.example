# ============================================================
# TravelHub — Root .env  (NEVER commit this file!)
# ============================================================
# Copy backend/.env values here so docker-compose can read them

# ── Supabase PostgreSQL (Direct / Pooler connection) ──────────
# Use the same value as backend/.env → DB_URL
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
DB_USERNAME=postgres.gzkohtgqtpbscczxuaaj
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# ── Supabase Storage (anon key) ───────────────────────────────
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# ── Gmail SMTP ────────────────────────────────────────────────
GMAIL_APP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ── PayHere ───────────────────────────────────────────────────
PAYHERE_SECRET=YOUR_PAYHERE_SECRET
PAYHERE_CURRENCY=USD

# ── Groq API (for chatbot LLM) ────────────────────────────────
GROQ_API_KEY=YOUR_GROQ_API_KEY
